# Dummy-only config for testing the direct GDB -> GDB copy-replace mechanism.
# Use with:  set AGENT_ENV_FILE=D:\01.STOCKWISE\sync-service\.env.dummy
# When AGENT_ENV_FILE is set, the production .env is NOT loaded at all.
#
# SYNC_ENV=dummy makes the Agent REFUSE (agent/guards.py):
#   - source port 3051 and D:\GUDANGSIG2025.GDB as a source
#   - the real staging folder D:\01.STOCKWISE\Staging
#   - the real STOCKWISE API on :8001 (dummy rows would overwrite accurate_* tables)
# Put credentials in the process environment, not in this file.

SYNC_ENV=dummy

# Dummy staging — its own folder, never the real one.
STAGING_PATH=D:\01.STOCKWISE\Staging\dummy-test\staging
STAGING_DB_NAME=STAGING.GDB
GBAK_BIN=D:\FirebirdLocal\Firebird_25\bin\gbak.exe
GFIX_BIN=D:\FirebirdLocal\Firebird_25\bin\gfix.exe
STAGING_MIN_FREE_MB=100
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_CLIENT_LIB=D:\FirebirdLocal\Firebird_25\bin\fbclient.dll

# Dummy SOURCE — a dummy DB on the STAGING server (3050).
SOURCE_FIREBIRD_HOST=127.0.0.1
SOURCE_FIREBIRD_PORT=3050
SOURCE_DATABASE=D:\01.STOCKWISE\Staging\dummy-test\SRC.GDB
SOURCE_GBAK_BIN=D:\FirebirdLocal\Firebird_25\bin\gbak.exe
SOURCE_COPY_TIMEOUT_SECONDS=600

BACKUP_PATH=D:\01.STOCKWISE\Staging\dummy-test\backups
BACKUP_PATTERN=GUDANGSIG2025*.gbk
STABILITY_CHECK_SECONDS=1
AGENT_STATE_PATH=D:\01.STOCKWISE\Staging\dummy-test\state.sqlite
AGENT_LOG_PATH=D:\01.STOCKWISE\Staging\dummy-test\logs
AGENT_LOCK_PATH=D:\01.STOCKWISE\Staging\dummy-test\agent.lock

# A mock/test API — never http://127.0.0.1:8001/api in dummy mode.
API_URL=http://127.0.0.1:18001/api
